# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# legacy sanity export - raw assets are large and reproducible via
# scripts/export-sanity.mjs; the JSON manifests are committed for reference
/sanity-export/assets

# payload local dev artifacts
/redendron.db
/redendron.db-journal
/public/media

# typescript
*.tsbuildinfo
next-env.d.ts
