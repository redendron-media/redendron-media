# ---------------------------------------------------------------------------
# Local development
#
# SQLite and on-disk uploads, so the project runs with no external services.
# ---------------------------------------------------------------------------
DATABASE_URI=file:./redendron.db
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production (Vercel)
#
# The adapter is chosen from the shape of DATABASE_URI, not from NODE_ENV, so
# the same build runs on either. Set these in the Vercel project instead:
#
#   DATABASE_URI            postgres://...   (Neon; Vercel injects this)
#   BLOB_READ_WRITE_TOKEN   vercel_blob_rw_...  (Vercel Blob injects this)
#   PAYLOAD_SECRET          a long random string, NOT the dev one
#   NEXT_PUBLIC_SITE_URL    https://www.redendron.com   (the canonical host -
#                           redendron.com redirects to www, and this value is
#                           what sitemap.xml and robots.txt are written with)
#
# Optional:
#   PAYLOAD_DISABLE_SCHEMA_PUSH=true
#     Stops Payload reconciling the Postgres schema on connect. Leave unset
#     for the first deploy against an empty database; set it once there is
#     data worth protecting and manage changes with migrations instead.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Brevo — transactional email and CRM
#
# Without a key the site still works: leads are stored in the database and the
# lead's Brevo status is recorded as "skipped" rather than failing submission.
# The from address must be a verified sender in Brevo.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
# Optional: the contact list new enquiries are added to.
BREVO_LIST_ID=
LEAD_NOTIFY_EMAIL=team@redendron.com
LEAD_FROM_EMAIL=team@redendron.com
# Test only — points the Brevo client at a local stub (tmp/brevo-stub.mjs).
# BREVO_API_BASE=

# ---------------------------------------------------------------------------
# Payload's own account email (password resets, verification) goes over the
# Brevo REST API using BREVO_API_KEY above. There is nothing else to set.
# With no key, Payload logs those emails to the console instead.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Seeding production from a local machine.
#
# Deliberately not DATABASE_URI: local development stays on SQLite, and
# `npm run seed:prod` has to be given production explicitly rather than
# inheriting it. Not needed on Vercel.
# ---------------------------------------------------------------------------
# NEON_DATABASE_URI=postgres://...
